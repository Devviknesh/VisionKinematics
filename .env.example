# Application Configuration
PROJECT_NAME="AI-Powered Video Analysis and Non-Verbal Communication Analyzer"
VERSION="1.0.0"

# Security
SECRET_KEY="replace-with-a-secure-random-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# For PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/video_analyzer_db"
# For SQLite (default out-of-the-box local mode):
DATABASE_URL="sqlite:///./video_analyzer.db"

# Video Processing Parameters
DEFAULT_SAMPLE_FPS=5.0
MAX_UPLOAD_SIZE_BYTES=262144000
MAX_VIDEO_DURATION_SECONDS=900
